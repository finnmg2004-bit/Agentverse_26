# Pixi environment
.pixi/
*.egg-info/

# Old Menagerie Go2 clone (no longer used; the Go2 comes from worlds/nerv-world)
mujoco_menagerie/

# Static nav-map cache, rebuilt automatically from the scene (sim/nav_map.py)
assets/maps/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Local model weights / temp recordings (models: `pixi run fetch-models`)
assets/models/
*.pt
*.onnx
*.tflite
*.mp4

# Secrets & API keys (NEVER commit or push)
.env
.env.*
*.key
*.pem
*secret*
*credentials*.json

# Editor
.vscode/

# taught tasks (overnight C1), per machine
assets/tasks.json
assets/tasks.tmp

# Evaluation datasets (ESC-50 etc., third-party licences: never commit) — `pixi run fetch-esc50`
assets/datasets/
# Hearing-eval raw outputs (the report + chart in docs/ are committed)
assets/eval/
