# Pixi environment
.pixi/
*.egg-info/

# Old Menagerie Go2 clone (no longer used; the Go2 comes from worlds/nerv-world)
mujoco_menagerie/

# Static nav-map cache, rebuilt automatically from the scene (sim/nav_map.py)
assets/maps/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Local model weights / temp recordings (models: `pixi run fetch-models`)
assets/models/
*.pt
*.onnx
*.tflite
*.mp4

# Secrets & API keys (NEVER commit or push)
.env
.env.*
*.key
*.pem
*secret*
*credentials*.json

# Editor
.vscode/
